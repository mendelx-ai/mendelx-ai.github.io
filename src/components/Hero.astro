---
import { copy } from '../content/copy.en';
const h = copy.hero;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <img class="hero-fallback" src="/hero-fallback.webp" alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
    <div class="hero-canvas" data-hero-canvas></div>
    <div class="hero-shade"></div>
  </div>

  <div class="hero-hud wrap" aria-hidden="true">
    <span class="label label--plain">{h.coords}</span>
    <span class="label label--plain hud-status"><span class="dot"></span>Scan / Active</span>
  </div>

  <div class="hero-content wrap">
    <p class="label reveal">{h.label}</p>
    <h1 id="hero-title" class="h1 reveal" style="--i:1">{h.title}</h1>
    <p class="lead reveal" style="--i:2">{h.sub}</p>
    <div class="hero-ctas reveal" style="--i:3">
      <a href="#pilot" class="btn btn--primary">{h.primary} <span class="arrow" aria-hidden="true">→</span></a>
      <a href="#partners" class="btn btn--ghost">{h.secondary}</a>
    </div>
  </div>

  <a href="#problem" class="hero-scroll" aria-label="Scroll to next section">
    <span class="label label--plain">{h.scroll}</span>
    <span class="scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero { position: relative; min-height: 100vh; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-fallback { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 1.2s var(--ease); }
  .hero-canvas { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s var(--ease); }
  .hero-canvas :global(canvas) { width: 100% !important; height: 100% !important; }
  .hero.is-live .hero-canvas { opacity: 1; }
  .hero.is-live .hero-fallback { opacity: 0; }
  .hero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(11,12,10,.75) 0%, rgba(11,12,10,0) 22%),
      linear-gradient(0deg, rgba(11,12,10,.96) 0%, rgba(11,12,10,.55) 38%, rgba(11,12,10,0) 70%);
  }
  .hero-hud {
    position: absolute; top: calc(var(--nav-h) + 20px); left: 0; right: 0; margin-inline: auto;
    display: flex; justify-content: space-between; pointer-events: none;
  }
  .hud-status { color: var(--text-dim); }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); display: inline-block; animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }

  .hero-content { padding-bottom: clamp(110px, 16vh, 170px); display: grid; gap: 26px; }
  .hero-content .h1 { max-width: 14ch; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }

  .hero-scroll { position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; text-decoration: none; }
  .scroll-line { width: 1px; height: 44px; background: linear-gradient(var(--text-dim), transparent); position: relative; overflow: hidden; }
  .scroll-line::after { content: ''; position: absolute; left: 0; width: 1px; height: 14px; background: var(--accent); animation: drop 2.2s var(--ease) infinite; }
  @keyframes drop { 0% { top: -14px; } 100% { top: 44px; } }

  @media (max-width: 640px) {
    .hero-hud .hud-status { display: none; }
    .hero-ctas .btn { width: 100%; }
    .hero-scroll { display: none; }
    .hero-content { padding-bottom: 64px; }
  }
</style>

<script>
  function lowPower(): boolean {
    const nav = navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
      deviceMemory?: number;
    };
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return true;
    // Phones get the still image: keeps the page fast on rural mobile connections.
    if (Math.min(window.innerWidth, window.screen?.width || window.innerWidth) < 768) return true;
    if (nav.connection?.saveData) return true;
    if (nav.connection?.effectiveType && /(^|-)(2g|3g)$/.test(nav.connection.effectiveType)) return true;
    if (typeof nav.deviceMemory === 'number' && nav.deviceMemory <= 2) return true;
    try {
      const c = document.createElement('canvas');
      if (!(c.getContext('webgl2') || c.getContext('webgl'))) return true;
    } catch { return true; }
    return false;
  }

  const host = document.querySelector<HTMLElement>('[data-hero-canvas]');
  const hero = host?.closest<HTMLElement>('.hero');
  if (host && hero && !lowPower()) {
    const start = () =>
      import('./../scripts/hero-pointcloud')
        .then((m) => m.mountPointCloud(host, () => hero.classList.add('is-live')))
        .catch(() => { /* keep the still image */ });
    // Let the page settle first; the still image is already showing.
    const idle = () => setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(() => start(), { timeout: 2000 }) : start()), 1200);
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }
</script>
