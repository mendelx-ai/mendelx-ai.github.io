---
import { copy } from '../content/copy.en';
const p = copy.problem;

// Build-time generated field grid: cells vary (soil/vigour), dose is uniform.
const COLS = 14, ROWS = 9, CELL = 40, GAP = 2;
const W = COLS * CELL, H = ROWS * CELL;
const v = (c: number, r: number) => {
  const x = c / COLS, y = r / ROWS;
  const n = Math.sin(x * 5.1 + 0.4) * 0.45 + Math.sin(y * 4.3 - x * 2.2 + 1.3) * 0.35 + Math.sin((x + y) * 9.7) * 0.2;
  return Math.min(1, Math.max(0, n * 0.5 + 0.5));
};
const cells = Array.from({ length: COLS * ROWS }, (_, i) => {
  const c = i % COLS, r = Math.floor(i / COLS);
  return { x: c * CELL, y: r * CELL, o: 0.05 + v(c, r) * 0.32 };
});
---
<section class="section problem" id="problem" aria-labelledby="problem-title">
  <div class="wrap problem-grid">
    <div class="problem-text">
      <p class="label reveal">{p.label}</p>
      <h2 id="problem-title" class="h2 reveal" style="--i:1">{p.title}</h2>
      <p class="body reveal" style="--i:2">{p.body}</p>
    </div>

    <figure class="problem-fig ticks reveal" style="--i:2">
      <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <g>
          {cells.map((c) => (
            <rect x={c.x + GAP / 2} y={c.y + GAP / 2} width={CELL - GAP} height={CELL - GAP} fill="#ECECE4" fill-opacity={c.o.toFixed(3)} />
          ))}
        </g>
        <g class="dose">
          {cells.map((c, i) => (
            <circle cx={c.x + CELL / 2} cy={c.y + CELL / 2} r="3" fill="#C6F432" style={`--d:${((i % COLS) * 0.07 + Math.floor(i / COLS) * 0.03).toFixed(2)}s`} />
          ))}
        </g>
      </svg>
      <figcaption class="fig-cap">
        <span class="label label--plain">{p.figureCaption}</span>
        <span class="legend" aria-hidden="true">
          <span><i class="sw sw-field"></i>Field</span>
          <span><i class="sw sw-dose"></i>Dose</span>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .problem-grid { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .problem-text { display: grid; gap: 28px; }
  .problem-text .h2 { max-width: 16ch; }
  .problem-fig { margin: 0; padding: 18px; border: 1px solid var(--line); background: var(--bg-raised); }
  .problem-fig svg { width: 100%; height: auto; }
  .dose circle { animation: fall 3.6s var(--ease) infinite; animation-delay: var(--d); }
  @keyframes fall {
    0% { transform: translateY(-14px); opacity: 0; }
    25% { transform: translateY(0); opacity: 1; }
    80% { opacity: 1; }
    100% { opacity: .35; }
  }
  .fig-cap { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; gap: 12px; flex-wrap: wrap; }
  .legend { display: flex; gap: 18px; font-family: var(--font-display); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-dim); }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .sw { width: 10px; height: 10px; display: inline-block; }
  .sw-field { background: linear-gradient(90deg, rgba(236,236,228,.1), rgba(236,236,228,.4)); }
  .sw-dose { background: var(--accent); border-radius: 50%; }
  @media (max-width: 900px) { .problem-grid { grid-template-columns: 1fr; } }
</style>
